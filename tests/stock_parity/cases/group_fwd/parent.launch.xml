<launch>
  <arg name="outer" default="o"/>
  <let name="drop" value="d"/>
  <set_env name="PL_OUTER_ENV" value="outer"/>
  <push-ros-namespace namespace="pushed"/>
  <group forwarding="false">
    <keep name="kept" value="$(var outer)_k"/>
    <node pkg="demo_nodes_cpp" exec="talker" name="fwd_off">
      <param name="kept" value="$(var kept)"/>
      <param name="drop" value="$(var drop missing)"/>
      <param name="envv" value="$(env PL_OUTER_ENV none)"/>
    </node>
  </group>
  <group scoped="no">
    <keep name="leak" value="L"/>
  </group>
  <group forwarding="true">
    <keep name="fk" value="$(var drop)"/>
    <node pkg="demo_nodes_cpp" exec="talker" name="fwd_on">
      <param name="fk" value="$(var fk)"/>
      <param name="drop" value="$(var drop)"/>
    </node>
  </group>
  <node pkg="demo_nodes_cpp" exec="talker" name="after">
    <param name="leak" value="$(var leak)"/>
    <param name="drop" value="$(var drop)"/>
  </node>
</launch>
