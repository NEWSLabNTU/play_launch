<?xml version="1.0"?>
<!-- contract_takeover_jitter with the availability publisher IN the tree:
     a gate on a 10 Hz timer released up to 6 ms late, which reports the
     odd_exit verdict. Its jitter is charged in the reported fault's
     detection and in the scope path's critical path. -->
<launch>
  <node pkg="demo_nodes_cpp" exec="talker" name="gate"/>
  <node pkg="demo_nodes_cpp" exec="listener" name="handler">
    <param name="takeover_timeout" value="10.0"/>
  </node>
  <node pkg="demo_nodes_cpp" exec="listener" name="comfort_op">
    <param name="min_acceleration" value="-1.0"/>
    <param name="min_jerk" value="-0.3"/>
  </node>
  <node pkg="demo_nodes_cpp" exec="listener" name="estop_op">
    <param name="target_acceleration" value="-2.5"/>
    <param name="target_jerk" value="-1.5"/>
  </node>
</launch>
