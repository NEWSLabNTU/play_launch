# I/O Stress Test

# Use bash for ROS setup scripts
set shell := ["bash", "-c"]

# ros-launch-resolve binary (layer 2 CLI) — `plot` moved off play_launch onto
# this standalone binary (adc33a7, RFC-0060 W3). Not part of the colcon
# install/ tree — it builds under plain cargo, no ROS — so it lives in its
# own workspace's target/. Release preferred, falls back to debug (mirrors
# tests/src/fixtures.rs::ros_launch_resolve_bin()).
# The binary that owns resolve/check/plot: play_launch itself.
#
# Layer 2 (ros-launch-resolve) is a LIBRARY in this repo, a path dependency of
# the play_launch crate built by the one colcon build. Its standalone CLI is
# for nano-ros, which builds it from the nested workspace on its own side; only
# the two privileged helpers are separate binaries here. Driving a second
# binary from this repo's tooling is what forced a manual cargo step into
# "just build" and what broke CI for a week when colcon's target-dir redirect
# moved it out from under the lookups.
resolve_bin := `
    for p in ../../../install/play_launch/lib/play_launch/play_launch; do
        [ -x "$p" ] && { echo "$p"; exit 0; }
    done
    echo play_launch
`

# Build io_stress package
build:
    @echo "Building io_stress package..."
    @cd ../../.. && colcon build --base-paths tests/fixtures/io_stress --symlink-install

# Run I/O stress test with monitoring
run:
    @echo "Running I/O stress test with monitoring..."
    @. ../../../install/setup.sh && play_launch launch io_stress io_stress.launch.xml

# Generate resource plots
plot:
    @echo "Generating resource plots..."
    @{{resolve_bin}} plot

# Clean artifacts
clean:
    @echo "Cleaning artifacts..."
    @rm -rf play_log record.json
