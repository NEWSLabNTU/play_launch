# I/O Stress Test

# Use bash for ROS setup scripts
set shell := ["bash", "-c"]

# ros-launch-resolve binary (layer 2 CLI) — `plot` moved off play_launch onto
# this standalone binary (adc33a7, RFC-0060 W3). Not part of the colcon
# install/ tree — it builds under plain cargo, no ROS — so it lives in its
# own workspace's target/. Release preferred, falls back to debug (mirrors
# tests/src/fixtures.rs::ros_launch_resolve_bin()).
resolve_bin := `
    for p in ../../../src/ros-launch-resolve/target/release/ros-launch-resolve \
             ../../../src/ros-launch-resolve/target/debug/ros-launch-resolve; do
        [ -f "$p" ] && { echo "$p"; exit 0; }
    done
    echo "../../../src/ros-launch-resolve/target/debug/ros-launch-resolve"
`

# Build io_stress package
build:
    @echo "Building io_stress package..."
    @cd ../../.. && colcon build --base-paths tests/fixtures/io_stress --symlink-install

# Run I/O stress test with monitoring
run:
    @echo "Running I/O stress test with monitoring..."
    @. ../../../install/setup.sh && play_launch launch io_stress io_stress.launch.xml

# Generate resource plots
plot:
    @echo "Generating resource plots..."
    @{{resolve_bin}} plot

# Clean artifacts
clean:
    @echo "Cleaning artifacts..."
    @rm -rf play_log record.json
