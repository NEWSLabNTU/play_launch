# Container Events Test Suite

# Variables
ros_distro := env_var_or_default('ROS_DISTRO', 'humble')

# ros-launch-resolve binary (layer 2 CLI) — `resolve` moved off play_launch
# onto this standalone binary (RFC-0060 W3, CLI verb reshape Task 6). Not
# part of the colcon install/ tree — it builds under plain cargo, no ROS —
# so it lives in its own workspace's target/. Release preferred, falls back
# to debug (mirrors tests/src/fixtures.rs::ros_launch_resolve_bin()).
# The binary that owns resolve/check/plot: play_launch itself.
#
# Layer 2 (ros-launch-resolve) is a LIBRARY in this repo, a path dependency of
# the play_launch crate built by the one colcon build. Its standalone CLI is
# for nano-ros, which builds it from the nested workspace on its own side; only
# the two privileged helpers are separate binaries here. Driving a second
# binary from this repo's tooling is what forced a manual cargo step into
# "just build" and what broke CI for a week when colcon's target-dir redirect
# moved it out from under the lookups.
resolve_bin := `
    for p in ../../../install/play_launch/lib/play_launch/play_launch; do
        [ -x "$p" ] && { echo "$p"; exit 0; }
    done
    echo play_launch
`

# Show help
default:
    @just --list

# Compare Rust vs Python parser output — SystemModel shape (Phase 47: the
# parser-parity gate runs on the model; record.json is retired).
compare-dumps:
    #!/usr/bin/env bash
    set -e
    REPO_ROOT="$(cd ../../.. && pwd)"
    . /opt/ros/{{ros_distro}}/setup.bash
    . "$REPO_ROOT/install/setup.bash"
    # Phase 46.5/47.B1 — colcon-built binary + current worktree's
    # `python/` package ahead of PATH/PYTHONPATH so this never silently
    # runs a stale pip install (the `--parser python` stale-scope-path
    # guard fails loud on that instead).
    export PATH="$REPO_ROOT/install/play_launch/lib/play_launch:$PATH"
    export PYTHONPATH="$REPO_ROOT/python:$PYTHONPATH"

    echo "=== Rust parser ==="
    {{resolve_bin}} resolve --parser rust -o model_rust.yaml launch/container_events.launch.xml
    echo "=== Python parser ==="
    {{resolve_bin}} resolve --parser python -o model_python.yaml launch/container_events.launch.xml
    echo "=== Diff ==="
    python3 "$REPO_ROOT/scripts/compare_models.py" model_rust.yaml model_python.yaml

# Clean generated files
clean:
    #!/usr/bin/env bash
    set -e
    echo "Cleaning up..."
    rm -rf play_log record.json model_rust.yaml model_python.yaml
    echo "Cleanup complete"
