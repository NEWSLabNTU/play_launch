<?xml version="1.0"?>
<!-- Sustained load: 32 nodes that burn during construction AND keep burning
     afterwards, at a duty cycle.

     Why this arm exists. W1 measured the runnable-task ceiling as WORSE than
     no gate (peak load1 217 against 183) because it cannot distinguish "busy
     starting things" from "busy running the things we started", so
     already-running nodes hold the gate shut until its bypass fires. W3's
     cpu_wave could not reproduce that: those nodes burn once and idle, the
     runnable count falls back on its own, and the gate never gets stuck.

     At 50% duty across 32 nodes this demands ~16 cores on a 12-core board, so
     the runnable count stays above any 2x-ncpu ceiling permanently — which is
     exactly the condition under which W1 says the gate misbehaves. If the
     ceiling is merely costly here too, W1's reasoning needs revisiting; if
     startup stalls to the bypass on every admission, it is confirmed.
-->
<launch>
  <arg name="burn_ms" default="3000"/>
  <arg name="sustain_duty_pct" default="90"/>
  <node pkg="governor_stress" exec="cpu_burn" name="burn_00" namespace="/stress" output="screen">
    <param name="burn_ms" value="$(var burn_ms)"/>
    <param name="sustain_duty_pct" value="$(var sustain_duty_pct)"/>
    <param name="sustain_period_ms" value="100"/>
  </node>
