<?xml version="1.0"?>
<!-- Memory gate: 24 plain nodes, each making 1 GiB resident.
     Peak demand ~24 GiB, well under a 64 GB Orin, so the box is never at
     real risk — the gate is made to bind by RAISING the floor in
     config/gate_on.yaml rather than by exhausting the machine.

     Why not exhaust it instead: on 64 GB the shipped floor is 1 GiB, so a
     genuine test of the default would need ~63 GiB resident, which risks the
     OOM killer taking something that matters and makes the run unrepeatable.
     Raising the floor tests the same code path with the same arithmetic.
     Run BOTH arms (gate_off / gate_on) or the numbers mean nothing. -->
<launch>
  <arg name="count" default="24"/>
  <arg name="alloc_mb" default="1024"/>
  <arg name="hold_secs" default="120"/>

  <node pkg="governor_stress" exec="mem_hog" name="hog_00" namespace="/stress" output="screen">
    <param name="alloc_mb" value="$(var alloc_mb)"/>
    <param name="hold_secs" value="$(var hold_secs)"/>
  </node>
  <node pkg="governor_stress" exec="mem_hog" name="hog_01" namespace="/stress" output="screen">
    <param name="alloc_mb" value="$(var alloc_mb)"/>
    <param name="hold_secs" value="$(var hold_secs)"/>
  </node>
