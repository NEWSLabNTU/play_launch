<?xml version="1.0"?>
<!-- Phase 91 E4: extension example 4 (UAV). -->
<launch>
  <node pkg="demo_nodes_cpp" exec="talker"   name="lidar_driver"      namespace="/safety">
    <param name="low_battery_fraction" value="0.30"/>
    <param name="reserve_fraction" value="0.22"/>
  </node>
  <node pkg="demo_nodes_cpp" exec="listener" name="obstacle_detector" namespace="/safety"/>
  <node pkg="demo_nodes_cpp" exec="listener" name="brake_controller"  namespace="/safety">
    <param name="descent_speed" value="3.0"/>
    <param name="slow_altitude" value="10.0"/>
    <param name="land_speed" value="0.7"/>
  </node>
</launch>
