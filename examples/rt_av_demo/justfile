# Mixed-criticality RT demo — build, run, and the A/B experiment.
#
#   just build     colcon build this workspace
#   just check     validate the contract + show the derived schedule
#   just trace     one run with RT applied, dumps a Chrome trace
#   just ab        THE experiment: same workload with RT off, then on
#
# Prerequisite for anything involving RT: `just setcap` in the repo root.
# Without CAP_SYS_NICE on play_launch_rt_helper the RT-on run is identical to
# the RT-off one and the comparison is meaningless. `just ab` refuses to run
# rather than print a table showing no difference.
#
# NOTE: a file capability lives on the inode, so ANY rebuild of play_launch
# replaces play_launch_rt_helper and silently drops it. Re-run `just setcap`
# after every build, not just the first one.

repo := justfile_directory() / "../.."
play_launch := repo / "install/play_launch/lib/play_launch/play_launch"
interception_so := repo / "src/play_launch_interception/target/release/libplay_launch_interception.so"

# How long each run lasts, and which CPUs the demo may use.
#
# ONE core, and that is calibrated, not arbitrary. Measured on this 32-core
# host: on two cores the safety chain misses ZERO deadlines no matter how much
# best-effort load is piled on (tested up to 60 ms burns — p99 stayed at
# 36 ms). CFS sleeper fairness is why: the chain is a low-duty-cycle task that
# sleeps between frames, so it accumulates low vruntime and gets picked first
# on every wake. CFS is genuinely good at exactly this. Only when the chain
# and the load share a single runqueue does priority start to matter.
#
# Widening this back to two cores does not weaken the experiment — it deletes
# it, and `just ab` will say INCONCLUSIVE rather than pretend otherwise.
duration := "25"
cpus := "2"

# Extra launch arguments, for retuning the pressure on a different machine
# without editing the launch file — e.g. `just --set launch_args
# "tool_burn:=45.0" ab`. Every burn and rate in bringup.launch.xml is an
# <arg>, so any of them can be overridden here.
launch_args := ""

# Samples to discard at the start of a run. Node discovery and DDS matching
# make the first seconds miss deadlines by 150 ms in ways scheduling cannot
# fix — counting them makes any baseline look like it failed, which would let
# a workload that never actually contends pass for a successful experiment.
warmup := "200"

default:
    @just --list

# Build the demo workspace.
build:
    #!/usr/bin/env bash
    set -e
    source /opt/ros/humble/setup.bash
    cd "{{ justfile_directory() }}"
    colcon build --symlink-install
    echo "built. now: just check"

# Validate the contract and print the derived schedule with provenance.
check:
    #!/usr/bin/env bash
    set -e
    source /opt/ros/humble/setup.bash
    source "{{ repo }}/install/setup.bash"
    source "{{ justfile_directory() }}/install/setup.bash"
    "{{ play_launch }}" check rt_av_demo bringup.launch.xml \
        --sched "$(ros2 pkg prefix rt_av_demo)/share/rt_av_demo/launch/bringup.system.posix.yaml" \
        --explain

# One run with RT applied; dumps a Chrome trace.
#
# Open the printed trace.json in chrome://tracing. Rows are nodes, arrows are
# messages flowing along the chain.
trace:
    #!/usr/bin/env bash
    set -e
    just _run on "{{ justfile_directory() }}/out/trace-on"
    echo
    echo "Chrome trace: $(ls {{ justfile_directory() }}/out/trace-on/play_log/*/interception/trace.json)"
    echo "Open chrome://tracing and load that file."

# THE experiment. Same workload twice: RT off, then RT on.
ab:
    #!/usr/bin/env bash
    set -e
    cd "{{ justfile_directory() }}"

    # Refuse rather than produce a meaningless comparison. Without the
    # capability the "on" run cannot apply anything, so both halves would be
    # identical and the table would read as "RT does nothing".
    helper="{{ repo }}/install/play_launch/lib/play_launch/play_launch_rt_helper"
    if ! getcap "$helper" 2>/dev/null | grep -q cap_sys_nice && [ "$(id -u)" != "0" ]; then
        echo "REFUSING: play_launch_rt_helper lacks cap_sys_nice, so the RT-on run" >&2
        echo "would apply nothing and the comparison would be vacuous." >&2
        echo "Run 'just setcap' in {{ repo }} first." >&2
        exit 1
    fi

    rm -rf out
    just _run off out/trace-off
    just _run on  out/trace-on
    just _report off on

# THE experiment, three arms: RT off, SCHED_FIFO, SCHED_DEADLINE.
#
# Needs ROOT, unlike `just ab`. A reservation must run inside an exclusive
# cpuset partition — a deadline thread's affinity may not be narrower than its
# root domain, so `taskset` cannot be the confinement and only root can create
# the partition. That is why this is a separate recipe: `just ab` stays
# unprivileged and unchanged.
#
# WARNING: creating the partition removes CPU {{ cpus }} from every other
# cgroup on the machine for the duration of the run. On a shared host, pick a
# CPU nobody is relying on.
ab3:
    #!/usr/bin/env bash
    set -e
    cd "{{ justfile_directory() }}"

    if [ "$(id -u)" != "0" ]; then
        echo "REFUSING: the deadline arm needs root to create an exclusive cpuset" >&2
        echo "partition. A SCHED_DEADLINE thread's affinity may not be narrower than" >&2
        echo "the root domain it was created on, so taskset cannot confine it and" >&2
        echo "sched_setattr would fail with EPERM for every reserved node." >&2
        echo "  sudo -E just ab3" >&2
        exit 1
    fi

    helper="{{ repo }}/install/play_launch/lib/play_launch/play_launch_rt_helper"
    if ! getcap "$helper" 2>/dev/null | grep -q cap_sys_nice && [ "$(id -u)" != "0" ]; then
        echo "REFUSING: play_launch_rt_helper lacks cap_sys_nice." >&2
        echo "Run 'just setcap' in {{ repo }} first." >&2
        exit 1
    fi

    rm -rf out
    just _run off      out/trace-off
    just _run on       out/trace-on
    just _run deadline out/trace-deadline
    just _report off on deadline

# Internal: one run. $1 = off|on, $2 = output dir.
_run mode outdir:
    #!/usr/bin/env bash
    set -e
    source /opt/ros/humble/setup.bash
    source "{{ repo }}/install/setup.bash"
    source "{{ justfile_directory() }}/install/setup.bash"

    mkdir -p "{{ outdir }}"
    cd "{{ outdir }}"

    cat > cfg.yaml <<'YAML'
    interception:
      enabled: true
      trace: true
    YAML

    share="$(ros2 pkg prefix rt_av_demo)/share/rt_av_demo/launch"
    case "{{ mode }}" in
      deadline) sched="$share/bringup.system.deadline.posix.yaml"; apply=strict ;;
      on)       sched="$share/bringup.system.posix.yaml";          apply=strict ;;
      *)        sched="$share/bringup.system.posix.yaml";          apply=off    ;;
    esac

    export PLAY_LAUNCH_INTERCEPTION_SO="{{ interception_so }}"
    export ROS_DOMAIN_ID=$(( 60 + RANDOM % 20 ))

    echo "=== run: RT {{ mode }} (--sched-apply $apply) ==="
    if [ "{{ mode }}" = "deadline" ]; then
        # The confinement mechanism CHANGES for this arm, and it has to.
        # `taskset` narrows the affinity mask, and a SCHED_DEADLINE thread may
        # not have a mask narrower than the root domain it was created on — so
        # under taskset every sched_setattr would fail with EPERM. The cpuset
        # partition IS the confinement here: it restricts the root domain
        # itself, which is the only form the kernel accepts.
        #
        # The workload is identical and lands on the same CPU either way; only
        # the mechanism differs. Worth stating in the report, because it is the
        # one thing that is not held constant across the three arms.
        timeout {{ duration }} "{{ repo }}/scripts/provision_rt_cpuset.sh" \
            --cpus {{ cpus }} --user "${SUDO_USER:-$(id -un)}" -- \
            "{{ play_launch }}" launch rt_av_demo bringup.launch.xml \
            --sched "$sched" --sched-apply "$apply" \
            --config cfg.yaml --disable-web-ui {{ launch_args }} > run.log 2>&1 || true
    else
        # taskset is what ACTUALLY confines the workload; isolated_cpus in the
        # platform file only declares the intent to the mapper.
        timeout {{ duration }} taskset -c {{ cpus }} \
            "{{ play_launch }}" launch rt_av_demo bringup.launch.xml \
            --sched "$sched" --sched-apply "$apply" \
            --config cfg.yaml --disable-web-ui {{ launch_args }} > run.log 2>&1 || true
    fi

    # `latest`, not a glob: play_log holds both the timestamp directory and a
    # `latest` symlink to it, so `play_log/*/` matches the same run twice and
    # doubles every count.
    out=play_log/latest/node/brake_controller/out
    echo "  chain samples: $(grep -c '^CHAIN ' "$out" 2>/dev/null || echo 0)"
    if grep -qi 'cap_sys_nice\|permission denied\|failed to set' run.log; then
        echo "  WARNING: run.log mentions a privilege failure — scheduling may not have applied"
    fi

# Internal: compare the runs. Arms are named on the command line.
_report *arms:
    #!/usr/bin/env bash
    set -e
    cd "{{ justfile_directory() }}"
    python3 - {{ warmup }} {{ arms }} <<'PY'
    import sys

    warmup = int(sys.argv[1])
    arms = sys.argv[2:] or ["off", "on"]

    # Display names, so the table says what the arm actually did rather than
    # repeating the internal mode word.
    LABEL = {"off": "RT OFF", "on": "SCHED_FIFO", "deadline": "SCHED_DEADLINE"}

    def samples(d):
        """Steady-state chain samples. Startup is discarded: the first seconds
        miss by ~150 ms purely from discovery, and scheduling cannot fix that.
        Counting them would let a non-contending workload look like a
        successful experiment."""
        path = f"out/trace-{d}/play_log/latest/node/brake_controller/out"
        try:
            lines = open(path).readlines()
        except OSError:
            return None
        out = []
        for line in lines:
            if not line.startswith("CHAIN "):
                continue
            kv = dict(p.split("=", 1) for p in line.split()[1:])
            if int(kv["seq"]) <= warmup:
                continue
            out.append((float(kv["latency_ms"]), kv["late"] == "1"))
        return out

    data = {}
    for arm in arms:
        s = samples(arm)
        if s is None:
            sys.exit(f"no brake_controller output for the '{arm}' run — it did not launch. "
                     f"Check out/trace-{arm}/run.log.")
        if len(s) < 100:
            sys.exit(f"'{arm}' produced only {len(s)} steady-state samples after a "
                     f"{warmup}-sample warmup — too few to compare. Raise `duration`.")
        data[arm] = s

    def row(name, xs):
        lat = sorted(x for x, _ in xs)
        miss = sum(1 for _, late in xs if late)
        p = lambda q: lat[min(int(len(lat) * q), len(lat) - 1)]
        return (name, p(0.50), p(0.99), lat[-1], miss, len(xs))

    rows = {arm: row(LABEL.get(arm, arm), data[arm]) for arm in arms}
    r_off = rows[arms[0]]
    print()
    print(f"steady state only, first {warmup} samples discarded")
    print(f"{'':16} {'p50':>9} {'p99':>9} {'max':>9} {'missed':>12}")
    for arm in arms:
        n, p50, p99, mx, miss, tot = rows[arm]
        print(f"{n:16} {p50:8.1f}ms {p99:8.1f}ms {mx:8.1f}ms {miss:>6}/{tot:<5}")
    print()
    if "deadline" in arms:
        print("NOTE: the deadline arm confines the workload with an exclusive cpuset")
        print("partition rather than taskset, because a SCHED_DEADLINE thread's affinity")
        print("may not be narrower than its root domain. Same CPU, same workload — but")
        print("the confinement MECHANISM is the one thing not held constant.")
        print()

    # A baseline that already meets its deadline means the workload never
    # contended, so the RT-on result proves nothing. That is inconclusive, not
    # success — the same vacuous-pass shape as issues 0008/0012/0014. Judged on
    # steady state: an earlier version of this check counted startup misses and
    # would have called a completely uncontended run a success.
    if r_off[4] == 0:
        sys.exit(f"INCONCLUSIVE: the RT-off baseline missed no deadlines in steady\n"
                 f"state (p99 {r_off[2]:.1f}ms against a {60.0}ms deadline), so there was\n"
                 f"nothing for scheduling to fix. Add pressure and re-run, e.g.\n"
                 f"  just --set launch_args 'tool_burn:=40.0' ab\n"
                 f"or narrow `cpus`.")

    def published(d):
        """Messages published per node, from the trace. This is what the
        safety chain's determinism COSTS: priority is zero-sum on a saturated
        core, so the best-effort nodes get less CPU and publish less. Reporting
        only the chain would show the benefit and hide the bill."""
        import json, collections
        path = f"out/trace-{d}/play_log/latest/interception/trace.json"
        try:
            ev = json.load(open(path))
        except (OSError, ValueError):
            return None
        rows = {x["pid"]: x["args"]["name"] for x in ev if x["ph"] == "M"}
        return collections.Counter(
            rows[x["pid"]] for x in ev if x.get("cat") == "publish"
        )

    pubs = {arm: published(arm) for arm in arms}
    base_arm = arms[0]
    if all(pubs.get(a) for a in arms):
        print("published messages, by criticality band (vs the baseline arm):")
        header = "  " + f"{'band':12}" + "".join(f"{LABEL.get(a, a):>18}" for a in arms)
        print(header)
        for band in ("/safety/", "/planning/", "/perception/", "/telemetry/", "/tools/"):
            base = sum(v for k, v in pubs[base_arm].items() if k.startswith(band))
            if not base:
                continue
            cells = ""
            for a in arms:
                n = sum(v for k, v in pubs[a].items() if k.startswith(band))
                cells += (f"{n:>10}" if a == base_arm
                          else f"{n:>10} ({100*(n-base)/base:+.0f}%)".rjust(18))
            print(f"  {band.strip('/'):12}{cells}")
        print()

    improved = False
    for arm in arms[1:]:
        r = rows[arm]
        if r[4] < r_off[4]:
            improved = True
            print(f"{r[0]} reduced steady-state deadline misses {r_off[4]} -> {r[4]} "
                  f"(p99 {r_off[2]:.1f}ms -> {r[2]:.1f}ms).")
        else:
            print(f"{r[0]}: NO IMPROVEMENT, {r_off[4]} -> {r[4]} misses. Either the "
                  f"schedule did not apply (check out/trace-{arm}/run.log for a privilege "
                  f"warning) or the safety chain is not the priority the mapper derived — "
                  f"compare against `just check`.")

    # The claim reservations exist to test: do they hold the deadline WHILE
    # giving best-effort back the throughput fixed priority took? Phase 57
    # measured that cost at 26-37%. Reported either way — a reservation that
    # keeps the chain and returns nothing is a real result, not a failure to
    # hide.
    if "deadline" in arms and "on" in arms and all(pubs.get(a) for a in arms):
        def be(arm):
            return sum(v for k, v in pubs[arm].items()
                       if not k.startswith("/safety/"))
        base, fifo, dl = be(arms[0]), be("on"), be("deadline")
        if base:
            print()
            print(f"best-effort throughput vs the RT-off baseline: "
                  f"SCHED_FIFO {100*(fifo-base)/base:+.0f}%, "
                  f"SCHED_DEADLINE {100*(dl-base)/base:+.0f}%")
            if dl > fifo:
                print("Reservations returned some of what fixed priority cost.")
            else:
                print("Reservations did NOT return best-effort throughput here. Without "
                      "SCHED_FLAG_RECLAIM a reservation idles its unused bandwidth "
                      "rather than yielding it, which is the likely reason.")

    if not improved:
        sys.exit(1)
    PY

# Remove build and run artifacts.
clean:
    rm -rf build install log out
