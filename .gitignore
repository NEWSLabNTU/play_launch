# Generated cargo config (from colcon-cargo-ros2). Written next to the crate
# being built, not only at the repo root — the root-anchored path alone left
# src/play_launch/.cargo/config.toml untracked-but-not-ignored, one `git add -A`
# away from committing a machine-specific file.
/.cargo/config.toml
**/.cargo/config.toml

# Binaries, libraries, and markers copied for wheel packaging (generated by 'just build')
python/play_launch/bin/
python/play_launch/lib/
python/play_launch/share/

# Parser output artifacts
/record.json

# Temporary files for testing/debugging
tmp/

# External repositories for study/reference
external/

# Node.js dependencies for Web UI linting.
# `package-lock.json` IS tracked: these checks were dev-only when this block
# was written, but `just check` runs them in CI now, so an unpinned transitive
# dependency can break the build with no change to this repo. The lockfile is
# also what makes `npm ci` and a stable CI cache key possible.
node_modules/

# Temporary lint extraction files
.tmp-extracted.js
.tmp-extracted.css

# Nextest JUnit output
junit.xml

