# The `play_launch` package on PyPI: no code, one extra per ROS distribution,
# each pulling that distribution's build (play_launch_<distro>, the real
# package, whose module and command are `play_launch`).
#
#   pip install "play_launch[jazzy]"
#
# The release workflow fills in @VERSION@ (the same for every package) and
# builds this; see .github/workflows/release-wheel.yml (build-meta).
[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "play_launch"
version = "@VERSION@"
description = "ROS 2 launch inspection tool. Install with your ROS distribution as an extra: pip install \"play_launch[jazzy]\""
readme = "README.md"
license = "BSD-3-Clause"
requires-python = ">=3.10"
authors = [{name = "Lin, Hsiang-Jui", email = "jerry73204@gmail.com"}]
classifiers = [
    "Development Status :: 4 - Beta",
    "Operating System :: POSIX :: Linux",
    "Programming Language :: Python :: 3",
]
keywords = ["ros2", "launch", "profiling", "monitoring", "robotics"]
dependencies = []

[project.optional-dependencies]
humble = ["play_launch_humble==@VERSION@"]
jazzy = ["play_launch_jazzy==@VERSION@"]
kilted = ["play_launch_kilted==@VERSION@"]
lyrical = ["play_launch_lyrical==@VERSION@"]
rolling = ["play_launch_rolling==@VERSION@"]

[project.urls]
Repository = "https://github.com/NEWSLabNTU/play_launch"

[tool.setuptools]
packages = []
